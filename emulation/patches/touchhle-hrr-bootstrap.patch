+#[cfg(test)]
+mod tests {
+    use super::Options;
+
+    #[test]
+    fn parses_independent_window_scaling() {
+        let mut options = Options::default();
+        assert_eq!(options.window_scale, None);
+        assert!(!options.nearest_neighbor);
+
+        assert_eq!(options.parse_argument("--window-scale=3"), Ok(true));
+        assert_eq!(options.window_scale.unwrap().get(), 3);
+        assert_eq!(options.parse_argument("--nearest-neighbor"), Ok(true));
+        assert!(options.nearest_neighbor);
+        assert_eq!(options.scale_hack.get(), 1);
+    }
+
+    #[test]
+    fn rejects_zero_window_scale() {
+        let mut options = Options::default();
+        assert!(options.parse_argument("--window-scale=0").is_err());
+    }
+}
